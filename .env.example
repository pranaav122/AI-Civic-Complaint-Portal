# ============================================
# Citizen Service Platform - Configuration
# ============================================

# --- Constituency Configuration ---
# Set your constituency name (displayed throughout the platform)
CONSTITUENCY_NAME="Model Constituency"
CONSTITUENCY_NAME_TAMIL="மாதிரி தொகுதி"
CONSTITUENCY_STATE="Tamil Nadu"
CONSTITUENCY_CENTER_LAT=13.0827
CONSTITUENCY_CENTER_LNG=80.2707
CONSTITUENCY_ZOOM=13

# --- Server Configuration ---
PORT=5000
NODE_ENV=development
JWT_SECRET=change-this-to-a-secure-random-string-in-production

# --- Admin Credentials (DEMO ONLY - CHANGE IN PRODUCTION) ---
# These are demo credentials for initial setup and testing.
# You MUST change these before any real deployment.
ADMIN_EMAIL=admin@constituency.gov.in
ADMIN_PASSWORD=Demo$ecure@2026!
ADMIN_NAME=Platform Administrator

# --- AI Configuration (Optional) ---
# Get your API key from: https://aistudio.google.com/apikey
# If not set, the platform uses rule-based classification as fallback.
GEMINI_API_KEY=

